# ─────────────────────────────────────────────────────────────────────────────
# ตัวอย่างค่า environment — คัดลอกเป็น .env แล้วเติมค่าจริง (.env ไม่ถูก commit)
#
# ตัวแปรที่มีเครื่องหมาย [Vercel] ต้องตั้งใน Vercel ด้วย ไม่ใช่แค่ในเครื่อง
#   npx vercel env add <NAME> production
# ─────────────────────────────────────────────────────────────────────────────

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────────
# ใช้ Neon (Postgres + pgvector) เป็นฐานข้อมูลหลัก — deploy คู่กับ Vercel
#
# runtime ใช้ endpoint แบบ **-pooler** (ต่อผ่าน PgBouncer เหมาะกับ serverless)
# ส่วนคำสั่ง migration ให้ **ตัด "-pooler" ออก** ก่อนรัน ไม่งั้น advisory lock ล้ม:
#   DATABASE_URL="<url ที่ไม่มี -pooler>" npx prisma migrate deploy
#   DATABASE_URL="<url ที่ไม่มี -pooler>" npx prisma db execute --file prisma/data/departments.sql
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"   # [Vercel]

# ทางเลือก: PostgreSQL บน Docker ในเครื่อง (spec §17) — พักไว้เพราะ server ยังไม่มี Docker
# DATABASE_URL="postgresql://ainative:<password>@localhost:5434/ainative?schema=public"
# POSTGRES_PASSWORD="<password>"        # docker-compose อ่านตัวนี้ไปสร้าง service db

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# ทั้งสองค่าต้องเป็น "โดเมนจริงที่ผู้ใช้เปิด" ไม่งั้น login จะ redirect ผิดที่
# บน Vercel ให้ใส่โดเมนของ deployment เช่น https://<project>.vercel.app
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"   # [Vercel]
BETTER_AUTH_URL="http://localhost:3000"               # [Vercel]
BETTER_AUTH_SECRET="<สุ่มอย่างน้อย 32 ตัวอักษร>"          # [Vercel]

# ── Social login ─────────────────────────────────────────────────────────────
# อย่าลืมเพิ่ม callback URL ของโดเมนใหม่ใน console ของแต่ละเจ้า ไม่งั้น login ไม่ผ่าน
#   <โดเมน>/api/auth/callback/github  ·  /google  ·  /line
GITHUB_CLIENT_ID="<...>"          # [Vercel]
GITHUB_CLIENT_SECRET="<...>"      # [Vercel]
GOOGLE_CLIENT_ID="<...>"          # [Vercel]
GOOGLE_CLIENT_SECRET="<...>"      # [Vercel]
LINE_CLIENT_ID="<...>"            # [Vercel]
LINE_CLIENT_SECRET="<...>"        # [Vercel]

# ── AI / RAG ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."                                # [Vercel] — embeddings + แชต
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"        # [Vercel]

# ── อีเมลแจ้งเตือน (Gmail SMTP) ───────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"        # [Vercel]
SMTP_PORT="587"                   # [Vercel]
GMAIL_USER="<อีเมลผู้ส่ง>"           # [Vercel]
GMAIL_APP_PASSWORD="<app password 16 หลัก>"   # [Vercel]
ADMIN_EMAIL="<อีเมลผู้ดูแล>"          # [Vercel]

# ── LINE Messaging API ───────────────────────────────────────────────────────
# LINE_CHANNEL_ACCESS_TOKEN="<...>"    # [Vercel]
# LINE_CHANNEL_SECRET="<...>"          # [Vercel]
# LINE_GROUP_IDS="<id1,id2>"           # [Vercel]

# ── ค่าตั้งต้นของระบบงาน ──────────────────────────────────────────────────────
DEFAULT_TIMEZONE="Asia/Bangkok"   # [Vercel]
DEFAULT_WORK_START="08:30"        # [Vercel]
DEFAULT_WORK_END="16:30"          # [Vercel]
TICKET_PREFIX="TK"                # [Vercel]
REQUEST_PREFIX="RQ"               # [Vercel]

# ── ไฟล์แนบ ──────────────────────────────────────────────────────────────────
# ⚠️ Vercel มี filesystem แบบอ่านอย่างเดียว — เก็บไฟล์ลงดิสก์ไม่ได้
#    ตอนนี้ยังไม่มีฟีเจอร์แนบไฟล์ (F1.7 อยู่ใน Phase 10A) จึงยังไม่กระทบ
#    แต่ถ้าจะทำต่อบน Vercel ต้องเปลี่ยน decision D1 ไปใช้ S3 / R2 / Vercel Blob
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE="10485760"

# ── อื่นๆ ────────────────────────────────────────────────────────────────────
# N8N_WEBHOOK_URL="<...>"
# STANDALONE_BUILD="true"   # ใส่เฉพาะตอน build image สำหรับ Docker — ห้ามใส่บน Vercel
